// The stock horizon's fragment (TerrainHorizon, 0x795f80): drawn with fog
// start 0 and end 1, so every pixel of it is the fog colour, only between the
// far clip less 50 yards and four far clips (0x791170, horizonFarclipScale).
// terrain_horizon.frag discards nearer than that; terrain_horizon_far.frag is
// for tiles wholly past it, without the discard, so the depth test can turn
// fragments away before they are shaded.

layout(set = 0, binding = 0) uniform PerFrame {
    mat4 view;
    mat4 projection;
    mat4 lightSpaceMatrix;
    vec4 lightDir;
    vec4 lightColor;
    vec4 ambientColor;
    vec4 viewPos;
    vec4 fogColor;
    vec4 fogParams;
    vec4 shadowParams;
    vec4 playerPos;
    vec4 playerWake;
    vec4 localLightPosRadius[64];
    vec4 localLightColorIntensity[64];
    ivec4 localLightMeta;
    vec4 volumetricParams;  // x = on, y = near, z = 1 / ln(far / near), w = slices
};

layout(set = 0, binding = 2) uniform sampler3D uFogVolume;

#ifdef HORIZON_COLOR
// The far field (rendering/far_field.hpp): x, y the near and far limits as
// distances in the plane, z the far clip, w the colour's gain; atlas: the
// first tile's x and y and the tiles across and down.
layout(push_constant) uniform Push {
    vec4 range;
    vec4 atlas;
} push;
layout(set = 1, binding = 0) uniform sampler2D uFarAtlas;
#include "stock_fog.glsli"
#else
// x: the near view depth (far clip - 50), y: the far one (4 far clips).
layout(push_constant) uniform Push {
    vec4 range;
} push;
#endif

layout(location = 0) in float vViewDepth;
layout(location = 1) in vec3 vWorldPos;

layout(location = 0) out vec4 outColor;

#ifdef HORIZON_LIT
layout(location = 2) in vec3 vNormal;

// E11, the lit horizon (rendering/horizon_detail.hpp, the same formula as
// reliefWeight and relief there): the fog colour scaled by how much more or
// less light this face takes than level ground, by an amount the haze
// allows - none at the near limit, where the real ground is already wholly
// fog, thinning to the far limit, and none in a zone whose fog ends well
// short of the far clip (push.range.z).
vec3 horizonRelief(vec3 color) {
    float farClip = max(push.range.z, 1.0);
    float t = clamp((vViewDepth - push.range.x) / max(push.range.y - push.range.x, 1.0), 0.0, 1.0);
    float rampIn = clamp(t / 0.06, 0.0, 1.0);
    float h = clamp((fogParams.y / farClip - 0.35) / (0.85 - 0.35), 0.0, 1.0);
    float w = 0.35 * (rampIn * rampIn * (3.0 - 2.0 * rampIn)) * pow(1.0 - t, 1.5) *
              (h * h * (3.0 - 2.0 * h));
    vec3 n = normalize(vNormal);
    vec3 toSun = normalize(-lightDir.xyz);
    float ndl = max(dot(n, toSun), 0.0);
    float level = max(toSun.z, 0.0);
    vec3 lit = min(ambientColor.rgb + lightColor.rgb * ndl, vec3(1.0));
    vec3 levelLit = max(min(ambientColor.rgb + lightColor.rgb * level, vec3(1.0)), vec3(0.02));
    vec3 r = clamp(lit / levelLit, vec3(0.5), vec3(1.5));
    return color * mix(vec3(1.0), r, w);
}
#endif

#ifdef HORIZON_COLOR
// The far field's own colour: the minimap atlas at this point, lit as
// terrain.frag lights the ground (ambient + sun x N.L, clamped at one per
// channel, times the shadow floor's average over sunlit and baked-shadowed
// ground), under the same stock fog. Over the last stretch of its reach it
// goes to the fog colour, so it ends in the sky's fog band, not at an edge.
const float kFarFieldShadowAverage = 0.95;
const float kFarFieldEdgeFadeFrom = 0.82;   // far_field::kEdgeFadeFrom

float farFieldDistance() { return length(vWorldPos.xy - viewPos.xy); }

vec3 farFieldColor() {
    const float kTile = 533.33333;
    vec2 tile = vec2(32.0 - vWorldPos.y / kTile, 32.0 - vWorldPos.x / kTile);
    vec2 uv = (tile - push.atlas.xy) / max(push.atlas.zw, vec2(1.0));
    vec3 albedo = texture(uFarAtlas, uv).rgb * push.range.w;
    vec3 n = normalize(vNormal);
    vec3 toSun = normalize(-lightDir.xyz);
    float ndl = max(dot(n, toSun), 0.0);
    vec3 light = min(ambientColor.rgb + lightColor.rgb * ndl, vec3(1.0));
    vec3 color = light * albedo * kFarFieldShadowAverage;
    color = mix(fogColor.rgb, color, stockFogVisibility(vWorldPos));
    float edge = smoothstep(push.range.y * kFarFieldEdgeFadeFrom, push.range.y, farFieldDistance());
    return mix(color, fogColor.rgb, edge);
}
#endif

vec4 horizonColor() {
#ifdef HORIZON_COLOR
    vec3 color = farFieldColor();
#else
    vec3 color = fogColor.rgb;
#ifdef HORIZON_LIT
    color = horizonRelief(color);
#endif
#endif
    // Wowee's air in front, as the terrain has it (terrain.frag applyFog), so
    // the horizon meets the ground it continues.
    if (volumetricParams.x > 0.5) {
        vec4 clip = projection * view * vec4(vWorldPos, 1.0);
        float depth = max(clip.w, 1e-4);
        vec2 uv = clip.xy / depth * 0.5 + 0.5;
        float slice = log(max(depth, volumetricParams.y) / volumetricParams.y) * volumetricParams.z;
        vec4 air = textureLod(uFogVolume, vec3(uv, slice - 0.5 / volumetricParams.w), 0.0);
        color = color * air.a + air.rgb;
    }
    return vec4(color, 1.0);
}
