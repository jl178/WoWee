// The sun's shadow (rendering/shadow_cache.hpp): the world map at set 0
// binding 1 (terrain, buildings and doodads, drawn once and kept) and the unit
// map at binding 5 (units and whatever moves near the player, every frame).
// The unit map is read only in the cells its mask marks, so most ground pays
// for one map's filter, as it did when there was one map.
//
// Include after the PerFrame block, which must end with
//     mat4 nearLightSpaceMatrix;
//     vec4 nearShadowParams;  // x on, y one texel (uv), z 1 / depth range (yd), w yards per texel
//     uvec4 nearShadowMask[32];
//     mat4 detailLightSpaceMatrix;
//     vec4 detailShadowParams;  // the same four, for the detail map at binding 6
// and declare viewPos, lightSpaceMatrix, shadowParams, localLightMeta and
// localLightTileScale (z: the angle one screen pixel spans, radians). The terrain,
// WMO, M2 and character fragment shaders share it, so the four filter alike.

layout(set = 0, binding = 1) uniform sampler2DShadow uShadowMap;
layout(set = 0, binding = 5) uniform sampler2DShadow uNearShadowMap;
// The detail map of Enhanced's sun shadows (shadow_cache.hpp): the world's
// casters over a short square round the player at a fine texel. Read only
// while detailShadowParams.x is set.
layout(set = 0, binding = 6) uniform sampler2DShadow uDetailShadowMap;

// One texel of the world map, handed in by the renderer. The map is 512,
// 1024, 2048 or 4096 a side by the quality setting; this used to be a
// constant for 4096, so at 512 the filter taps all landed inside one texel
// and the bias shrank eightfold. The fallback covers a per-frame block that
// never filled the slot in, such as the character preview's.
float shadowTexel() {
    return shadowParams.z > 0.0 ? shadowParams.z : 1.0 / 4096.0;
}

float shadowFilter(sampler2DShadow smap, vec3 coords, float t, bool stockOnly) {
    // The stock filter (Wow.exe 0x8742e0, docs/re/world-lighting.md "Shadow
    // map filter"): the centre and four fixed taps, k0 k2 k4 k6 in texels,
    // equal weights. The tent below is the Soft setting.
    if (stockOnly || (localLightMeta.z & 8) == 0) {
        float s = texture(smap, coords)
                + texture(smap, vec3(coords.xy + vec2( 0.8, -1.0) * t, coords.z))
                + texture(smap, vec3(coords.xy + vec2( 0.2, -0.6) * t, coords.z))
                + texture(smap, vec3(coords.xy + vec2(-0.6, -0.2) * t, coords.z))
                + texture(smap, vec3(coords.xy + vec2(-1.0, -0.4) * t, coords.z));
        return s * 0.2;
    }
    // Soft: four bilinear compares at the corners of a square 1.5 texels
    // across - each one is a 2x2 compare already, so the four together are a
    // smooth tent about 3.5 texels wide with no grain. It was five taps on a
    // disk turned per pixel by screen-space noise; at a 2048 map over the
    // 500 yd distance (half a yard a texel) that noise was a coarse speckle
    // on every penumbra, and under FSR2's jitter it crawled. One tap fewer
    // and no trigonometry (enhancements-plan.md 3.15).
    vec2 o = vec2(0.75 * t);
    return 0.25 * (texture(smap, vec3(coords.xy + vec2(-o.x, -o.y), coords.z))
                 + texture(smap, vec3(coords.xy + vec2( o.x, -o.y), coords.z))
                 + texture(smap, vec3(coords.xy + vec2(-o.x,  o.y), coords.z))
                 + texture(smap, vec3(coords.xy + vec2( o.x,  o.y), coords.z)));
}

bool nearShadowCell(vec2 uv) {
    uvec2 cell = min(uvec2(uv * 64.0), uvec2(63u));
    uint bit = cell.y * 64u + cell.x;
    uint word = bit >> 5;
    // The word picked with selects, not v[word & 3]: a vector indexed by a
    // varying value is spilled to scratch memory on some drivers.
    uvec4 v = nearShadowMask[word >> 2];
    uint c = word & 3u;
    uint w = c == 0u ? v.x : (c == 1u ? v.y : (c == 2u ? v.z : v.w));
    return ((w >> (bit & 31u)) & 1u) != 0u;
}

// How much of the sun reaches `pos` (1 lit, 0 shaded) on a surface facing
// `norm` (the surface's own normal, not a bumped one), `ldir` toward the sun.
// The caller checks shadowParams.x first.
//
// Both maps are biased the same way, in yards: the receiver is moved along
// its normal by the filter's reach in texels times sin(angle to the light),
// which lifts it off its own plane by reach x tan(angle) of depth - exactly
// what a tilted surface needs so that no tap of the filter reads the surface
// itself - and a quarter of a texel of plain depth bias covers the depth's
// own rounding. It was a normal offset of 1/2048 of a yard (a uv texel taken
// for a world length) and a fixed depth bias of 0.16-1.6 yd at the 500 yd
// distance whatever the map's size: acne on slopes facing the sun at the
// 2048 map, and shadows lifted off their casters at grazing light.
float shadowReceiverOffset(vec3 norm, vec3 ldir) {
    float c = clamp(abs(dot(norm, ldir)), 0.0, 1.0);
    return sqrt(1.0 - c * c);
}

// The detail map at `pos`: its shadow, and in `w` how much of the answer it
// gives - 1 well inside its square, easing to 0 over the outer tenth (the
// world map takes over there, as Enhanced blends its cascades), 0 outside.
// `spread` is the filter's half-width in texels: four bilinear compares at
// the corners of a square that wide, from half a texel at the camera (a
// hard edge, the dapples of cut-out leaves kept) to a texel and a half where
// a screen pixel spans that much of the map. The receiver offset follows the
// world map's rule at this map's texel.
float detailShadowAt(vec3 pos, vec3 norm, float sinA, float spread, out float w) {
    w = 0.0;
    float texelYd = detailShadowParams.w;
    vec3 p = pos + norm * (texelYd * (spread + 1.25) * sinA);
    vec4 ls = detailLightSpaceMatrix * vec4(p, 1.0);
    vec2 uv = ls.xy * 0.5 + 0.5;
    float edge = min(min(uv.x, uv.y), min(1.0 - uv.x, 1.0 - uv.y));
    if (edge <= 0.01 || ls.z < 0.0 || ls.z > 1.0) return 1.0;
    w = smoothstep(0.01, 0.09, edge);
    float z = ls.z - 0.25 * texelYd * detailShadowParams.z;
    vec2 o = vec2(spread * detailShadowParams.y);
    return 0.25 * (texture(uDetailShadowMap, vec3(uv + vec2(-o.x, -o.y), z))
                 + texture(uDetailShadowMap, vec3(uv + vec2( o.x, -o.y), z))
                 + texture(uDetailShadowMap, vec3(uv + vec2(-o.x,  o.y), z))
                 + texture(uDetailShadowMap, vec3(uv + vec2( o.x,  o.y), z)));
}

// `far` true: one bilinear compare for the world map instead of the filter -
// where a screen pixel already spans a texel and a half of the map, the
// filter's width is below what the pixel shows, and the far half of a 2560-
// wide view is most of its pixels (enhancements-plan.md 3.15).
// `detailSpread`: the detail map's filter half-width (detailShadowAt); 0 or
// less reads the world map alone.
float sunShadowAt(vec3 pos, vec3 norm, vec3 ldir, bool far, float detailSpread) {
    float shadow = 1.0;
    float sinA = shadowReceiverOffset(norm, ldir);

    // The detail map first: well inside it the world map is not read.
    float dw = 0.0;
    float ds = 1.0;
    if (detailShadowParams.x > 0.5 && detailSpread > 0.0) ds = detailShadowAt(pos, norm, sinA, detailSpread, dw);

    float t = shadowTexel();
    // The world map is orthographic: its first row's length is two over its
    // width in yards, its third row's one over its depth in yards.
    vec3 row0 = vec3(lightSpaceMatrix[0][0], lightSpaceMatrix[1][0], lightSpaceMatrix[2][0]);
    vec3 row2 = vec3(lightSpaceMatrix[0][2], lightSpaceMatrix[1][2], lightSpaceMatrix[2][2]);
    float texelYd = 2.0 * t / max(length(row0), 1e-9);
    vec3 biasedPos = pos + norm * (texelYd * 2.5 * sinA);
    vec4 lsPos = lightSpaceMatrix * vec4(biasedPos, 1.0);
    vec3 proj = lsPos.xyz / lsPos.w;
    proj.xy = proj.xy * 0.5 + 0.5;
    if (dw < 1.0 && proj.x >= 0.0 && proj.x <= 1.0 && proj.y >= 0.0 && proj.y <= 1.0 && proj.z >= 0.0 && proj.z <= 1.0) {
        float bias = 0.25 * texelYd * length(row2);
        shadow = far ? texture(uShadowMap, vec3(proj.xy, proj.z - bias))
                     : shadowFilter(uShadowMap, vec3(proj.xy, proj.z - bias), t, false);
    }
    shadow = mix(shadow, ds, dw);

    // Already wholly in the world's shadow, a unit's can add nothing.
    if (nearShadowParams.x > 0.5 && shadow > 0.0) {
        // The same rule at the unit map's texel (nearShadowParams.w yards),
        // for its stock five taps (about two texels of reach).
        vec3 nearPos = pos + norm * (nearShadowParams.w * 2.5 * sinA);
        vec4 ns = nearLightSpaceMatrix * vec4(nearPos, 1.0);
        vec3 np = ns.xyz / ns.w;
        vec2 nuv = np.xy * 0.5 + 0.5;
        if (nuv.x >= 0.0 && nuv.x < 1.0 && nuv.y >= 0.0 && nuv.y < 1.0 && np.z >= 0.0 && np.z <= 1.0 &&
            nearShadowCell(nuv)) {
            float nbias = 0.5 * nearShadowParams.w * nearShadowParams.z;
            // Five taps whatever the setting: the unit map's texels are a
            // fifth of the world map's, so they are soft enough, and this is
            // the second filter these pixels pay for.
            shadow = min(shadow, shadowFilter(uNearShadowMap, vec3(nuv, np.z - nbias), nearShadowParams.y, true));
        }
    }
    return shadow;
}

float sunShadowAt(vec3 pos, vec3 norm, vec3 ldir, bool far) {
    return sunShadowAt(pos, norm, ldir, far, 1.0);
}

// The surfaces' entry. A pixel's footprint is its distance times the angle
// one pixel spans (localLightTileScale.z, set every frame), grown on a
// surface seen at a slant; no derivatives, so it is safe after a discard.
float sunShadow(vec3 pos, vec3 norm, vec3 ldir, bool worldOnly) {
    vec3 row0 = vec3(lightSpaceMatrix[0][0], lightSpaceMatrix[1][0], lightSpaceMatrix[2][0]);
    float texelYd = 2.0 * shadowTexel() / max(length(row0), 1e-9);
    vec3 toEye = viewPos.xyz - pos;
    float dist = length(toEye);
    float slant = max(abs(dot(norm, toEye)) / max(dist, 1e-4), 0.25);
    float pixelYd = dist * localLightTileScale.z / slant;
    // The detail map's filter widens with the pixel's footprint on it.
    float spread = detailShadowParams.w > 0.0 && localLightTileScale.z > 0.0
        ? clamp(pixelYd / detailShadowParams.w, 0.5, 1.5) : 1.0;
    if (worldOnly) spread = 0.0;
    return sunShadowAt(pos, norm, ldir, localLightTileScale.z > 0.0 && pixelYd > 1.5 * texelYd, spread);
}

float sunShadow(vec3 pos, vec3 norm, vec3 ldir) {
    return sunShadow(pos, norm, ldir, false);
}

// One bilinear compare a map, for what is drawn by the hundred thousand and
// small on screen - the grass field's blades (grass.frag), lit from straight
// up as the ground under them is: the detail map where it covers the blade,
// else the world map, and the unit map where its mask says a unit's shade
// can fall. the reference client's clutter takes its shadow so: one SampleCmp on the
// cascade (detaildoodad.bls).
float sunShadowCheap(vec3 pos, vec3 ldir) {
    // Lifted off the ground it stands on by the world map's rule for an
    // upward normal, at each map's texel.
    float sinA = shadowReceiverOffset(vec3(0.0, 0.0, 1.0), ldir);
    float shadow = 1.0;
    bool done = false;
    if (detailShadowParams.x > 0.5) {
        vec4 ls = detailLightSpaceMatrix * vec4(pos + vec3(0.0, 0.0, 2.0 * detailShadowParams.w * sinA), 1.0);
        vec2 uv = ls.xy * 0.5 + 0.5;
        float edge = min(min(uv.x, uv.y), min(1.0 - uv.x, 1.0 - uv.y));
        if (edge > 0.05 && ls.z >= 0.0 && ls.z <= 1.0) {
            shadow = texture(uDetailShadowMap, vec3(uv, ls.z - 0.25 * detailShadowParams.w * detailShadowParams.z));
            done = true;
        }
    }
    if (!done) {
        vec3 row0 = vec3(lightSpaceMatrix[0][0], lightSpaceMatrix[1][0], lightSpaceMatrix[2][0]);
        vec3 row2 = vec3(lightSpaceMatrix[0][2], lightSpaceMatrix[1][2], lightSpaceMatrix[2][2]);
        float texelYd = 2.0 * shadowTexel() / max(length(row0), 1e-9);
        vec4 lsPos = lightSpaceMatrix * vec4(pos + vec3(0.0, 0.0, 2.0 * texelYd * sinA), 1.0);
        vec3 proj = lsPos.xyz / lsPos.w;
        proj.xy = proj.xy * 0.5 + 0.5;
        if (proj.x >= 0.0 && proj.x <= 1.0 && proj.y >= 0.0 && proj.y <= 1.0 && proj.z >= 0.0 && proj.z <= 1.0)
            shadow = texture(uShadowMap, vec3(proj.xy, proj.z - 0.25 * texelYd * length(row2)));
    }
    if (nearShadowParams.x > 0.5 && shadow > 0.0) {
        vec4 ns = nearLightSpaceMatrix * vec4(pos + vec3(0.0, 0.0, 2.0 * nearShadowParams.w * sinA), 1.0);
        vec2 nuv = ns.xy / ns.w * 0.5 + 0.5;
        float nz = ns.z / ns.w;
        if (nuv.x >= 0.0 && nuv.x < 1.0 && nuv.y >= 0.0 && nuv.y < 1.0 && nz >= 0.0 && nz <= 1.0 &&
            nearShadowCell(nuv))
            shadow = min(shadow, texture(uNearShadowMap, vec3(nuv, nz - 0.5 * nearShadowParams.w * nearShadowParams.z)));
    }
    return shadow;
}
