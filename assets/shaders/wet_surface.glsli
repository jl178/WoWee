// Wet ground in rain - not stock, the "Wet ground in rain" setting. Shared by
// terrain.frag and wmo.frag (exterior groups only); needs the PerFrame block
// declared above it.
//
// rtParams.w is how wet the world is, 0 dry .. 1 soaked, eased by the renderer
// over 10-20 seconds as rain starts and stops (WetGround). It is 0 with the
// setting off, in the reflection pass and in the character preview, and then
// every function here returns its input unchanged.
//
// Water darkens a porous surface (it fills the pores, so less light scatters
// back out) and lays a thin film over it that catches the sun and, at grazing
// angles, the sky. Both are kept mild: the ground reads damp, not mirrored.

// How wet this surface is. Surfaces facing up hold the water; a wall takes
// half and the underside of an overhang none, which is the only roof test
// there is - a porch floor under an exterior roof still darkens.
float wetSurfaceAmount(vec3 geomNormal) {
    float w = rtParams.w;
    if (w <= 0.0) return 0.0;
    return w * clamp(0.5 + 0.5 * geomNormal.z, 0.0, 1.0);
}

// The albedo darkened by the water in it: 20% at most.
vec3 wetSurfaceAlbedo(vec3 albedo, float wet) {
    return albedo * (1.0 - 0.20 * wet);
}

#include "rain_ripples.glsli"

// Rain ripples on the ground (the "Rain ripples" setting): rtParams.z is how
// hard it is raining for them, 0 while dry or with the setting off. Rings
// form only where the ground would hold a puddle - level, soaked through,
// and in the hollows a slow noise picks out - and near the eye. The caller
// checks rtParams.z first, a uniform, so the width's derivative is taken in
// uniform control flow and a dry frame costs one compare.
vec3 wetGroundRipples(vec3 geomNormal, vec3 worldPos, float dist, float wet, float width) {
    float level = smoothstep(0.88, 0.96, geomNormal.z);
    float soaked = smoothstep(0.45, 0.85, wet);
    float hollow = smoothstep(0.48, 0.62, rrNoise(worldPos.xy * 0.22));
    float near = 1.0 - smoothstep(15.0, 28.0, dist);
    float puddle = level * soaked * hollow * near;
    if (puddle <= 0.0) return vec3(0.0);
    vec2 slope = rainRippleSlope(worldPos.xy, fogParams.z, rtParams.z, width);
    return rainRippleLight(slope, worldPos, viewPos.xyz,
                           ambientColor.rgb * 0.7 + lightColor.rgb * 0.25) * puddle;
}

// The film's sheen, added to the lit colour before fog: a tight sun highlight
// under the shadow, and a faint sky-coloured Fresnel rim. Faded out past the
// middle distance, where it would only shimmer.
vec3 wetSurfaceSheen(vec3 normal, vec3 worldPos, float dist, float wet, float shadow) {
    float amount = wet * (1.0 - smoothstep(60.0, 220.0, dist));
    if (amount <= 0.001) return vec3(0.0);
    vec3 v = normalize(viewPos.xyz - worldPos);
    vec3 l = normalize(-lightDir.xyz);
    vec3 h = normalize(l + v);
    float gloss = pow(max(dot(normal, h), 0.0), 64.0) * 0.30;
    float fresnel = pow(1.0 - clamp(dot(normal, v), 0.0, 1.0), 5.0) * 0.18;
    // No highlight on a face turned from the light.
    float facing = smoothstep(0.0, 0.2, dot(normal, l));
    return amount * (lightColor.rgb * (gloss * shadow * facing) + ambientColor.rgb * fresnel);
}

// Snow settling while it snows - not stock, the "Snow settles" setting.
// localLightTileScale.w is how far it has settled, 0 bare .. 1, eased over
// minutes by the renderer (weather_fx::easeSnowCover) and 0 without snow or
// with the setting off; then this returns 0 and the caller leaves the
// albedo alone. Snow lies on faces turned up, spreads out from the patches
// a slow noise picks as it settles, and leaves ground that is already pale -
// a snowfield's own texture - as it is.
float snowCoverAmount(vec3 geomNormal, vec3 albedo, vec3 worldPos) {
    float c = localLightTileScale.w;
    if (c <= 0.0) return 0.0;
    float up = smoothstep(0.55, 0.9, geomNormal.z);
    if (up <= 0.0) return 0.0;
    float lum = dot(albedo, vec3(0.299, 0.587, 0.114));
    float bare = 1.0 - smoothstep(0.5, 0.75, lum);
    if (bare <= 0.0) return 0.0;
    // One octave: the patches' shape, cheap enough for every ground pixel.
    float n = rrNoise(worldPos.xy * 0.11);
    // Soft-edged patches, never a full sheet: a dusting, not a snowfield.
    float lies = smoothstep(1.0 - 0.8 * c, 1.45 - 0.8 * c, n);
    return up * bare * lies * 0.45;
}

// The albedo under that snow: toward a cold off-white, which the scene's
// own light then lights - grey at dusk, blue under a storm sky.
vec3 snowCoverAlbedo(vec3 albedo, float s) {
    return mix(albedo, vec3(0.80, 0.83, 0.88), s);
}
